UPLOAD_GRANT_SECRET_B64=<Gateway와 같은 32바이트 이상 표준 Base64>
WORKER_API_TOKEN=<Gateway와 같은 값, UPLOAD_GRANT_SECRET_B64와는 다른 값>
GATEWAY_BASE_URL=<Gateway https origin, path 없이>
WORKER_DATA_DIR=<저장소 밖 절대경로, Windows는 드라이브 경로, ',' 없이>
# PowerShell `(Get-Command docker).Source` 결과
DOCKER_PATH=<docker 실행 파일 절대경로>
# 바꾸면 tailscale serve 대상 포트도 같이 바꾼다.
ECHONOTE_WORKER_PORT=4318
