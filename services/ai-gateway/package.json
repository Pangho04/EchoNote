{
  "name": "@echonote/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "dev:test": "tsx watch --env-file-if-exists=.env.local --env-file=.env.test.local src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run --exclude \"**/*.db.test.ts\"",
    "test:db": "vitest run src/jobs/job-repository.db.test.ts",
    "typecheck": "tsc --noEmit",
    "seal:transcripts:local": "tsx --env-file=.env.test.local src/scripts/seal-existing-transcripts.ts --target=local",
    "seal:transcripts:remote": "tsx --env-file=.env.local src/scripts/seal-existing-transcripts.ts --target=remote"
  },
  "dependencies": {
    "@echonote/contracts": "workspace:*",
    "fastify": "5.11.2",
    "jose": "6.2.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.5",
    "typescript": "catalog:",
    "undici-types": "catalog:",
    "vitest": "catalog:"
  }
}
