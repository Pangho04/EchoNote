# 실기기가 LAN으로 접속하는 개발 환경에서만 0.0.0.0. 생략하면 127.0.0.1.
ECHONOTE_BIND_HOST=0.0.0.0
# 로컬 Supabase로 띄울 때는 SUPABASE_URL·SUPABASE_SECRET_KEY·TRANSCRIPT_KEK_B64(테스트 전용 값)를 .env.test.local에 두고 pnpm dev:gateway:test로 실행한다. 뒤에 읽는 이 파일 값이 우선한다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<Supabase 대시보드 API Keys의 secret key>
UPLOAD_GRANT_SECRET_B64=<openssl rand -base64 32 출력>
WORKER_RECEIVER_BASE_URL=https://<windows-node>.<tailnet>.ts.net
WORKER_API_TOKEN=<UPLOAD_GRANT_SECRET_B64와 별도로 openssl rand -base64 32 출력, Windows Worker와 같은 값>
# 전사문을 잠그는 열쇠. openssl rand -base64 32 출력, 위 두 비밀과 다른 값. 잃으면 저장된 전사문을 복구할 수 없다.
TRANSCRIPT_KEK_B64=<openssl rand -base64 32 출력>
