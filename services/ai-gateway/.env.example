SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<Supabase 대시보드 API Keys의 secret key>
UPLOAD_GRANT_SECRET_B64=<openssl rand -base64 32 출력>
WORKER_RECEIVER_BASE_URL=https://<windows-node>.<tailnet>.ts.net
WORKER_API_TOKEN=<UPLOAD_GRANT_SECRET_B64와 별도로 openssl rand -base64 32 출력, Windows Worker와 같은 값>
