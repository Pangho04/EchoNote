{
  "name": "@echonote/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "aos": "expo run:android",
    "aos:device": "expo run:android --device",
    "build": "pnpm run build:ios && pnpm run build:aos",
    "build:aos": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "e2e": "maestro test e2e/maestro",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "lint": "eslint .",
    "native:generate": "expo prebuild --clean",
    "native:generate:aos": "expo prebuild --clean --platform android",
    "native:generate:ios": "expo prebuild --clean --platform ios",
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "test": "pnpm run test:unit && pnpm run test:ui",
    "test:ui": "jest --runInBand",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "axios": "1.20.0",
    "expo": "57.0.24",
    "expo-audio": "57.0.5",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "3.1.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
