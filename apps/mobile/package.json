{
  "name": "@echonote/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "build": "pnpm run build:ios && pnpm run build:android",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "lint": "eslint .",
    "native:generate": "expo prebuild --clean",
    "native:generate:android": "expo prebuild --clean --platform android",
    "native:generate:ios": "expo prebuild --clean --platform ios",
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "test": "pnpm run test:unit && pnpm run test:ui",
    "test:ui": "jest --passWithNoTests --runInBand",
    "test:unit": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "57.0.11",
    "expo-audio": "57.0.3",
    "expo-constants": "57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "57.0.5",
    "expo-router": "57.0.11",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "test-renderer": "1.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
